# SAP HANA (via bridge Python)
# La API se conecta a HANA a traves del bridge (bridge/hana_bridge.py),
# NO mediante un driver ODBC. Rellena tus datos reales en tu propio .env
# (el .env local esta ignorado por git; este archivo es solo el ejemplo).

# Host/puerto SQL de la base (para referencia; es el bridge quien lo usa)
DB_SERVERNODE=IP_O_HOST_DEL_SERVIDOR_HANA:30015
DB_DATABASE=DB_NAME
DB_DATABASE_NAME=NDB

# Credenciales
DB_USER=
DB_PASSWORD=

# Bridge HANA (servicio Python en 127.0.0.1)
# Debe coincidir con el del bridge (BRIDGE_TOKEN del bridge).
BRIDGE_URL=http://127.0.0.1:8088/query
BRIDGE_TOKEN=

# Entorno
APP_ENV=production
APP_DEBUG=false
