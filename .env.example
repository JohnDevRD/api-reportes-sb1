# Bridge HANA (servicio Python en 127.0.0.1)
# La API habla con HANA SOLO a traves del bridge; aqui NO se guardan
# credenciales de la base. Estas viven en el entorno del bridge
# (bridge/.bridge.env en Windows, o /etc/hana-bridge.env en Linux).
BRIDGE_URL=http://127.0.0.1:8088/query
BRIDGE_TOKEN=

# Entorno
APP_ENV=production
APP_DEBUG=false
