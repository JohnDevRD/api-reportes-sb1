# Bridge HANA: copia este archivo a `.bridge.env` (en la carpeta bridge/) y
# rellena tus datos reales. .bridge.env NO se sube a git (esta en .gitignore).
# Este archivo lo lee el propio hana_bridge.py cuando se corre el bridge de
# forma directa (p. ej. Windows con windows\run_bridge.bat). En LINUX con
# systemd la configuracion va en /etc/hana-bridge.env (no se usa este archivo).

HANAB1_HOST=IP_O_HOST_DEL_SERVIDOR_HANA
HANAB1_PORT=30015
HANA_USER=TU_USUARIO_BD
HANA_PASSWORD=TU_CONTRASENA_BD
HANA_SCHEMA=TU_ESQUEMA_DONDE_ESTA_LA_VISTA
BRIDGE_TOKEN=TU_TOKEN_LARGO
BRIDGE_LISTEN=127.0.0.1
BRIDGE_PORT=8088