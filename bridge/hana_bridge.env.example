# Configuracion del bridge HANA (copiar a /etc/hana-bridge.env y proteger)
# Estas variables las lee hana_bridge.py al arrancar.

# --- Servidor HANA (la VM SUSE, alcanzable via Tailscale) ---
HANAB1_HOST=IP_O_HOST_DEL_SERVIDOR_HANA
HANAB1_PORT=30015

# --- Credenciales de la base (igual que en .env de la API) ---
HANA_USER=TU_USUARIO_BD
HANA_PASSWORD=TU_CONTRASENA_BD

# --- Seguridad del bridge ---
# Passa un secreto y usa el mismo valor en BRIDGE_TOKEN del .env de la API.
BRIDGE_TOKEN=cambia-este-token-por-un-secreto-largo
BRIDGE_LISTEN=127.0.0.1
BRIDGE_PORT=8088
