# Configuracion del bridge HANA para LINUX (systemd): copiar a
# /etc/hana-bridge.env y proteger (chmod 600). Estas variables las
# lee hana_bridge.py al arrancar (las inyecta systemd como entorno).

# --- Servidor HANA ---
HANAB1_HOST=IP_O_HOST_DEL_SERVIDOR_HANA
HANAB1_PORT=30015

# --- Credenciales de la base (las usa el bridge, no la API) ---
HANA_USER=TU_USUARIO_BD
HANA_PASSWORD=TU_CONTRASENA_BD

# --- Esquema donde viven las vistas (p. ej. DB_ACV) ---
HANA_SCHEMA=TU_ESQUEMA_DONDE_ESTA_LA_VISTA

# --- Seguridad del bridge ---
# Usa el MISMO valor que BRIDGE_TOKEN del .env de la API.
BRIDGE_TOKEN=TU_TOKEN_LARGO
BRIDGE_LISTEN=127.0.0.1
BRIDGE_PORT=8088
